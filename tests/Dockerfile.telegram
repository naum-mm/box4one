FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY backend/requirements.txt /tmp/backend.txt
COPY telegram_bot/requirements.txt /tmp/bot.txt
RUN pip install --no-cache-dir -r /tmp/backend.txt -r /tmp/bot.txt
COPY . .
RUN git init && git add .
ENV PYTHONPATH=/workspace/backend:/workspace
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
