# Single project settings file. Install generates secrets; never commit actual .env.
# COMPOSE_PROFILES=telegram enables cloud mode; telegram,telegram-local enables the local service after migration.
DOMAIN=example.com
MARIADB_DATABASE=ytdlp
MARIADB_USER=ytdlp
MARIADB_ROOT_PASSWORD=GENERATED_BY_INSTALLER
MARIADB_PASSWORD=GENERATED_BY_INSTALLER
WORKER_API_TOKEN=GENERATED_BY_INSTALLER
DOWNLOAD_ACCESS_WORD=GENERATED_BY_INSTALLER
QUEUE_ACCESS_WORD=GENERATED_BY_INSTALLER
JOB_TTL_MINUTES=30
POLL_INTERVAL=5
VIDEO_PLAYLIST_LIMIT=50
AUDIO_PLAYLIST_LIMIT=100
MIN_FREE_GB=2
MAX_JOB_GB=2
DISK_CHECK_SECONDS=1
RETRY_MAX_SECONDS=60
TELEGRAM_HISTORY_LIMIT=10
ARCHIVE_MAX_CONCURRENT=1
CLEANUP_INTERVAL_SECONDS=60
COMPOSE_PROFILES=
COMPOSE_PROJECT_NAME=ytdlp-web
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_TOKEN=GENERATED_BY_INSTALLER
TELEGRAM_ALLOWED_USERS=
# Legacy identities only; this is no longer an access requirement.
TELEGRAM_ACTIVATION_WORD=REDACTED_ACTIVATION_WORD
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL_API_ENABLED=false
TELEGRAM_LOCAL_API_URL=http://telegram-api:8081
TELEGRAM_LOCAL_UPLOAD_LIMIT_BYTES=2000000000
TELEGRAM_API_MEMORY=256m
TELEGRAM_API_SWAP=512m
TELEGRAM_PUBLIC_URL=
TELEGRAM_API_URL=http://backend:8000
TELEGRAM_MAX_ACTIVE_JOBS=2
TELEGRAM_POLL_SECONDS=10
TELEGRAM_UPLOAD_LIMIT_BYTES=49000000
TELEGRAM_LINK_TTL_SECONDS=600
TELEGRAM_DRAFT_TTL_MINUTES=60
TELEGRAM_MAX_DRAFTS_PER_HOUR=60
TELEGRAM_CHAT_INTERVAL_SECONDS=1.1
TELEGRAM_SEND_INTERVAL_SECONDS=0.06
DB_MEMORY=128m
DB_SWAP=256m
DB_BUFFER_POOL_SIZE=32M
DB_MAX_CONNECTIONS=30
BACKEND_MEMORY=128m
BACKEND_SWAP=256m
WORKER_MEMORY=384m
WORKER_SWAP=768m
TELEGRAM_MEMORY=192m
TELEGRAM_SWAP=384m
PROXY_MEMORY=64m
PROXY_SWAP=128m
SERVICE_CPU_LIMIT=0.5
LOG_MAX_SIZE=5m
LOG_MAX_FILES=2
INTERNAL_NETWORK_NAME=
EGRESS_NETWORK_NAME=
EGRESS_NETWORK_EXTERNAL=false
