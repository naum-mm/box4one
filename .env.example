# Reference only. install.sh generates actual secrets. Do not copy placeholders.
DOMAIN=example.com
MARIADB_DATABASE=ytdlp
MARIADB_USER=ytdlp
MARIADB_ROOT_PASSWORD=GENERATED_BY_INSTALLER
MARIADB_PASSWORD=GENERATED_BY_INSTALLER
WORKER_API_TOKEN=GENERATED_BY_INSTALLER
DOWNLOAD_ACCESS_WORD=GENERATED_BY_INSTALLER
QUEUE_ACCESS_WORD=GENERATED_BY_INSTALLER
JOB_TTL_MINUTES=30
POLL_INTERVAL=5
VIDEO_PLAYLIST_LIMIT=50
AUDIO_PLAYLIST_LIMIT=100
MIN_FREE_GB=2
MAX_JOB_GB=3
DISK_CHECK_SECONDS=1
